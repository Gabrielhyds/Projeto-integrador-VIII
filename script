  caixas.gorro = { x: x0 - 34 * s, y: chao + (hy - 48) * s, w: 68 * s, h: 50 * s, ok: itens.gorro.on && frio > .2 };

  // rosto
  fx.fillStyle = "#1d2433"; fx.strokeStyle = "#1d2433"; fx.lineWidth = 3;
