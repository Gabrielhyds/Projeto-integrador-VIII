function personagem(agora){
  const s = Math.min(W, H) / 520;
  const x0 = W * .28, chao = H * .9;
  const vestido = ITENS.filter(k => itens[k].on).length;
  const nu = 1 - vestido / ITENS.length;          // 0 vestido, 1 sem nada
  const sente = clamp(frio * (.4 + nu));          // frio que ele SENTE

  // lógica da morte: sem roupa nenhuma num frio forte por 3 s
  if (!morte.inicio) {
    if (vestido === 0 && frio > .5) morte.exposto += 1 / 60; else morte.exposto = Math.max(0, morte.exposto - 2 / 60);
    if (calor > .8) morte.aquecendo += 1 / 60; else morte.aquecendo = Math.max(0, morte.aquecendo - 2 / 60);
    if (morte.exposto > 3) { morte.inicio = agora; morte.tipo = "frio"; anunciarMorte(); }
