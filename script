  ITENS.forEach(k => {
    const p = itens[k].solto; if (!p) return;
    if (!p.arrastando) {
      p.vy += .6; p.x += p.vx; p.y += p.vy; p.vx *= .97; p.rot += p.vx * .02;
      if (p.y > chao - 6 * s) { p.y = chao - 6 * s; p.vy *= -.3; p.vx *= .7; }
    }
    fx.save(); fx.translate(p.x, p.y); fx.rotate(p.rot); fx.scale(s, s);
    if (k === "gorro") desenharGorro(fx);
    else if (k === "cachecol") desenharCachecol(fx, agora);
    else { fx.translate(0, 36); desenharCasaco(fx, 38); }
    fx.restore();
  });

  if (!morto && sente > .3 && quadro % 6 === 0) fumacas.push({ x: x0 + 20 * s, y: chao + (hy + 14) * s, r: 4 * s, a: .5 });
  if (derreteu && quadro % 8 === 0 && agora - morte.inicio < 6000) fumacas.push({ x: x0 + (Math.random() * 160 - 80) * s, y: chao - 10 * s, r: 6 * s, a: .4 });
  if (!morto && calor > .3 && Math.random() < calor * .15 + derretendo * .5) gotas.push({ x: x0 + (Math.random() * 50 - 25) * s, y: chao + (hy - 15) * s, v: 0 });
  for (let i = fumacas.length - 1; i >= 0; i--) {
    const f = fumacas[i]; f.x += 1.2 * s; f.y -= .5 * s; f.r += .5 * s; f.a -= .008;
    if (f.a <= 0) { fumacas.splice(i, 1); continue; }
    fx.fillStyle = `rgba(255,255,255,${f.a})`; fx.beginPath(); fx.arc(f.x, f.y, f.r, 0, 7); fx.fill();
  }
  fx.fillStyle = "rgba(140,210,255,.9)";
  for (let i = gotas.length - 1; i >= 0; i--) {
    const g = gotas[i]; g.v += .25; g.y += g.v;
    if (g.y > chao) { gotas.splice(i, 1); continue; }
    fx.beginPath(); fx.moveTo(g.x, g.y - 6 * s); fx.quadraticCurveTo(g.x + 4 * s, g.y, g.x, g.y + 3 * s);
    fx.quadraticCurveTo(g.x - 4 * s, g.y, g.x, g.y - 6 * s); fx.fill();
  }
}

/* ---------- mouse: arrancar a roupa dele ---------- */
let segurando = null, ultimoPonto = null;
const dentro = (b, x, y) => b && b.ok && x >= b.x && x <= b.x + b.w && y >= b.y && y <= b.y + b.h;
function itemSob(x, y){ return morte.inicio ? null : ["gorro", "cachecol", "casaco"].find(k => dentro(caixas[k], x, y)); }
