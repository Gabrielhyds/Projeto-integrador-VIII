  }
  caixas.casaco = { x: x0 - larg * s, y: chao + (yCorpo - 72) * s, w: larg * 2 * s, h: 72 * s, ok: mostraCasaco };

  // braços
  fx.strokeStyle = mostraCasaco ? COR_CASACO() : pele; fx.lineWidth = 13;
  const ombro = yCorpo - 58 + respira;
  fx.beginPath();
  if (morto) {
