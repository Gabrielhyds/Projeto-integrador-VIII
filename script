let quadro = 0;
function desenhar(agora){
  quadro++;
  // suaviza para a mudança ser gradual, nunca um salto
  frio += (alvoFrio - frio) * .02;
  calor += (alvoCalor - calor) * .02;
  if (tempAlvo !== null) { tempVista = tempVista === null ? tempAlvo : tempVista + (tempAlvo - tempVista) * .08; $("#num").textContent = tempVista.toFixed(1).replace(".", ","); }

  /* céu */
  const g = cx.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, rgb(corCeu(0))); g.addColorStop(.6, rgb(corCeu(1))); g.addColorStop(1, rgb(corCeu(2)));
  cx.fillStyle = g; cx.fillRect(0, 0, W, H);

  /* sol: cresce e brilha com o calor; some atrás de nuvem no frio */
  const sx = W * .78, sy = H * mix(.32, .22, calor), sr = mix(40, 110, calor) * (1 - frio * .5);
  cx.save(); cx.globalAlpha = 1 - frio * .8;
  const halo = cx.createRadialGradient(sx, sy, sr * .4, sx, sy, sr * mix(2.5, 6, calor));
  halo.addColorStop(0, `rgba(255,${Math.round(mix(240, 170, calor))},120,${mix(.35, .8, calor)})`);
  halo.addColorStop(1, "rgba(255,150,60,0)");
  cx.fillStyle = halo; cx.fillRect(0, 0, W, H);
  if (calor > .05) {           // raios girando
    cx.translate(sx, sy); cx.rotate(agora / 6000);
    cx.fillStyle = `rgba(255,210,120,${calor * .25})`;
    for (let i = 0; i < 12; i++) { cx.rotate(Math.PI / 6); cx.beginPath(); cx.moveTo(0, -sr * .8); cx.lineTo(sr * .25, -sr * 3.5 * calor - sr); cx.lineTo(-sr * .25, -sr * 3.5 * calor - sr); cx.fill(); }
    cx.setTransform(1, 0, 0, 1, 0, 0);
  }
  cx.beginPath(); cx.arc(sx, sy, sr * (1 + Math.sin(agora / 400) * .03 * calor), 0, 7);
  cx.fillStyle = `rgb(255,${Math.round(mix(235, 200, calor))},${Math.round(mix(170, 90, calor))})`; cx.fill();
  cx.restore();

  /* nuvens carregadas no frio */
  if (frio > .02) {
    cx.fillStyle = `rgba(230,238,248,${frio * .55})`;
    for (let i = 0; i < 6; i++) {
      const x = ((i * 260 + agora / 60) % (W + 400)) - 200, y = H * (.12 + (i % 3) * .07);
      for (let k = 0; k < 4; k++) { cx.beginPath(); cx.arc(x + k * 55, y + Math.sin(k) * 12, 50 + k * 6, 0, 7); cx.fill(); }
    }
  }

  /* montanhas: secas e avermelhadas no calor, com neve no frio */
  const passo = W / (serra.length - 1);
  cx.beginPath(); cx.moveTo(0, H);
  serra.forEach((h, i) => cx.lineTo(i * passo, H * h));
  cx.lineTo(W, H); cx.closePath();
  cx.fillStyle = rgb([Math.round(mix(mix(25, 60, frio), 90, calor)), Math.round(mix(mix(55, 80, frio), 40, calor)), Math.round(mix(mix(70, 120, frio), 30, calor))]);
  cx.fill();
  if (frio > .05) {
    cx.save(); cx.clip();
    cx.fillStyle = `rgba(250,253,255,${frio})`;
    serra.forEach((h, i) => { cx.beginPath(); cx.arc(i * passo, H * h, passo * .9 * frio + 4, 0, 7); cx.fill(); });
    cx.fillRect(0, H * .86 + (1 - frio) * 80, W, H);    // chão coberto de neve
    cx.restore();
  }

  /* ar tremendo de calor (filtro SVG) */
  $("#desloc").setAttribute("scale", (calor * 22).toFixed(1));
  $("#turb").setAttribute("baseFrequency", `0.008 ${(.03 + Math.sin(agora / 700) * .006).toFixed(4)}`);

  /* camada da frente (sem tremor): partículas e geada */
  fx.clearRect(0, 0, W, H);

  // folhas ao vento: só no clima ameno
  const ameno = 1 - Math.max(frio, calor);
  folhas.forEach((p, i) => {
    p.f += .03; p.g += .05; p.x += p.v; p.y += Math.sin(p.f) * 1.2;
    if (p.x > W + 20) folhas[i] = novaFolha();
    fx.save(); fx.globalAlpha = ameno * .8; fx.translate(p.x, p.y); fx.rotate(p.g);
    fx.fillStyle = "#8fd18a"; fx.beginPath(); fx.ellipse(0, 0, 9, 4, 0, 0, 7); fx.fill(); fx.restore();
  });

  // neve: quantidade e vento proporcionais ao frio
  const qtdNeve = Math.round(neve.length * frio), vento = 1 + frio * 2.5;
  fx.fillStyle = "rgba(255,255,255,.9)";
  for (let i = 0; i < qtdNeve; i++) {
    const p = neve[i]; p.f += .02;
    p.y += p.v * vento; p.x += Math.sin(p.f) * .8 + frio * 1.5;
    if (p.y > H + 10 || p.x > W + 10) { neve[i] = novaNeve(true); continue; }
    fx.beginPath(); fx.arc(p.x, p.y, p.t, 0, 7); fx.fill();
  }

  // brasas subindo: quantidade e velocidade proporcionais ao calor
  const qtdBrasa = Math.round(brasas.length * calor);
  fx.save(); fx.shadowColor = "#ff7a2e"; fx.shadowBlur = 10;
  for (let i = 0; i < qtdBrasa; i++) {
    const p = brasas[i]; p.f += .08;
    p.y -= p.v * (1 + calor); p.x += Math.sin(p.f) * 1.1;
    if (p.y < -10) { brasas[i] = novaBrasa(true); continue; }
    const a = .5 + .5 * Math.sin(p.f * 3);
    fx.fillStyle = `rgba(255,${Math.round(120 + 90 * a)},50,${.4 + .6 * a})`;
    fx.beginPath(); fx.arc(p.x, p.y, p.t, 0, 7); fx.fill();
  }
  fx.restore();

  personagem(agora);

  // geada nas bordas da tela
  if (frio > .02) {
    const gr = fx.createRadialGradient(W / 2, H / 2, Math.min(W, H) * mix(.75, .3, frio), W / 2, H / 2, Math.max(W, H) * .75);
    gr.addColorStop(0, "rgba(220,240,255,0)"); gr.addColorStop(1, `rgba(225,242,255,${frio * .85})`);
    fx.fillStyle = gr; fx.fillRect(0, 0, W, H);
  }
  // vermelho pulsando nas bordas no calor extremo
  if (calor > .5) {
    const a = (calor - .5) * 2 * (.25 + .2 * Math.sin(agora / 300));
    const gr = fx.createRadialGradient(W / 2, H / 2, Math.min(W, H) * .35, W / 2, H / 2, Math.max(W, H) * .75);
    gr.addColorStop(0, "rgba(255,60,30,0)"); gr.addColorStop(1, `rgba(255,60,30,${a})`);
    fx.fillStyle = gr; fx.fillRect(0, 0, W, H);
  }

  $(".valor").style.color = rgb([Math.round(mix(mix(255, 200, frio), 255, calor)), Math.round(mix(mix(255, 235, frio), 225, calor)), Math.round(mix(mix(255, 255, frio), 200, calor))]);
  requestAnimationFrame(desenhar);
}
