      fx.beginPath(); fx.arc(0, 0, 26, Math.PI, 0); fx.lineTo(26, 34);
      for (let k = 0; k < 4; k++) fx.quadraticCurveTo(19 - k * 13, 26, 13 - k * 13, 34);
      fx.closePath(); fx.fill();
      fx.fillStyle = "#1d2433"; fx.beginPath(); fx.arc(-9, -2, 4, 0, 7); fx.arc(9, -2, 4, 0, 7); fx.fill();
