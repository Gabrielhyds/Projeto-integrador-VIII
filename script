"""
Painel de temperatura com cenário animado (sem termômetro).

Quanto mais frio: céu azul-gelo, neve caindo, geada nas bordas, montanhas nevadas.
Quanto mais quente: céu laranja, sol crescendo, brasas subindo, ar tremendo.
No meio: céu calmo, folhas levadas pelo vento.

Instalar:  py -m pip install flask requests
Rodar:     py main.py
Abrir:     http://localhost:5000
"""
import math
import random
import re
import time

import requests
from flask import Flask, Response, jsonify

# ---------------- Configuração ----------------
URL_SENSOR = "http://10.246.152.235/temperaturec"
SENSOR_LIGADO = False      # True quando o sensor real estiver conectado
LIMITE_MIN = 2.0           # abaixo disso: alerta de frio
LIMITE_MAX = 30.0          # acima disso: alerta de calor
FRIO_COMECA = 12.0         # a partir daqui o cenário começa a esfriar
CALOR_COMECA = 24.0        # a partir daqui o cenário começa a esquentar
SIMULAR_SE_OFFLINE = True  # gera valores falsos se o sensor não responder
# ----------------------------------------------

app = Flask(__name__)
inicio = time.time()
demo = {"modo": None}
ultimo = {"v": 18.0}
ALVOS_DEMO = {"quente": 40.0, "frio": -6.0}


def ler_sensor():
    resp = requests.get(URL_SENSOR, timeout=1)
    resp.raise_for_status()
    match = re.search(r"-?\d+(?:[.,]\d+)?", resp.text)
    if not match:
        raise ValueError(f"Resposta sem número: {resp.text!r}")
    return float(match.group().replace(",", "."))


def valor_simulado():
    if demo["modo"] in ALVOS_DEMO:
        alvo = ALVOS_DEMO[demo["modo"]]
        v = ultimo["v"] + (alvo - ultimo["v"]) * 0.15
    else:
        base = 18 + 6 * math.sin((time.time() - inicio) / 20)
        v = ultimo["v"] + (base - ultimo["v"]) * 0.25
    v += random.uniform(-0.3, 0.3)
    ultimo["v"] = v
    return round(v, 2)


@app.route("/api/temp")
def api_temp():
    simulado = True
    if demo["modo"]:
        temp = valor_simulado()
    elif not SENSOR_LIGADO:
        temp = valor_simulado()
    else:
        try:
            temp = ler_sensor()
            ultimo["v"] = temp
            simulado = False
        except Exception as e:
            if not SIMULAR_SE_OFFLINE:
                return jsonify(ok=False, erro=str(e)), 502
            temp = valor_simulado()
    return jsonify(ok=True, temp=temp, simulado=simulado, demo=demo["modo"],
                   min=LIMITE_MIN, max=LIMITE_MAX,
                   frio=FRIO_COMECA, calor=CALOR_COMECA,
                   hora=time.strftime("%H:%M:%S"))


@app.route("/api/demo/<modo>", methods=["POST"])
def api_demo(modo):
    demo["modo"] = modo if modo in ALVOS_DEMO else None
    return jsonify(ok=True, modo=demo["modo"])


