    [-10, 10].forEach(ex => { fx.beginPath(); fx.moveTo(ex - 5, hy - 7); fx.lineTo(ex + 5, hy + 3); fx.moveTo(ex + 5, hy - 7); fx.lineTo(ex - 5, hy + 3); fx.stroke(); });
    fx.beginPath(); fx.moveTo(-8, hy + 14); fx.lineTo(8, hy + 14); fx.stroke();
  } else {
    if (calor > .4) {
      fx.beginPath(); fx.roundRect(-22, hy - 8, 19, 11, 4); fx.roundRect(3, hy - 8, 19, 11, 4); fx.fill();
      fx.beginPath(); fx.moveTo(-3, hy - 4); fx.lineTo(3, hy - 4); fx.stroke();
    } else if (sente > .5) {
      fx.beginPath(); fx.moveTo(-15, hy - 3); fx.lineTo(-7, hy); fx.lineTo(-15, hy + 3);
      fx.moveTo(15, hy - 3); fx.lineTo(7, hy); fx.lineTo(15, hy + 3); fx.stroke();
    } else {
      const pisca = (agora % 3500) < 120 ? .2 : 1;
      fx.beginPath(); fx.ellipse(-10, hy - 2, 3.5, 4.5 * pisca, 0, 0, 7); fx.ellipse(10, hy - 2, 3.5, 4.5 * pisca, 0, 0, 7); fx.fill();
    }
    fx.beginPath();
    if (sente > .5) {
      const bate = Math.sin(agora / 40) * 1.5;
      fx.fillStyle = "#fff"; fx.fillRect(-9, hy + 10 + bate, 18, 6); fx.strokeRect(-9, hy + 10 + bate, 18, 6);
    } else if (calor > .6) {
      fx.arc(0, hy + 12, 8, 0, Math.PI); fx.fillStyle = "#7a1f2b"; fx.fill();
      fx.fillStyle = "#ff7b9c"; fx.beginPath(); fx.ellipse(0, hy + 20, 5, 6, 0, 0, 7); fx.fill();
    } else { fx.arc(0, hy + 6, 10, .2, Math.PI - .2); fx.stroke(); }
  }

  // bloco de gelo crescendo em volta dele
  const gelo = morto ? (morte.tipo === "frio" ? ease : 0) : congelando * .5;
  if (gelo > 0) {
    fx.fillStyle = `rgba(190,230,255,${.25 + gelo * .35})`; fx.strokeStyle = `rgba(255,255,255,${gelo})`; fx.lineWidth = 3;
    const alt = 210 * gelo;
    fx.beginPath(); fx.roundRect(-55, -alt, 110, alt, 8); fx.fill(); fx.stroke();
    fx.strokeStyle = `rgba(255,255,255,${gelo * .6})`;
    fx.beginPath(); fx.moveTo(-40, -alt + 20); fx.lineTo(-20, -alt + 60); fx.moveTo(30, -alt + 40); fx.lineTo(42, -alt + 90); fx.stroke();
  }
  fx.restore();

