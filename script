  const k = itemSob(e.clientX, e.clientY); if (!k) return;
  itens[k].on = false;
  itens[k].solto = { x: e.clientX, y: e.clientY, vx: 0, vy: 0, rot: 0, arrastando: true };
  segurando = k; ultimoPonto = { x: e.clientX, y: e.clientY };
  frente.setPointerCapture(e.pointerId);
});
frente.addEventListener("pointermove", e => {
  if (segurando) {
    const p = itens[segurando].solto;
    p.vx = e.clientX - ultimoPonto.x; p.vy = e.clientY - ultimoPonto.y;
    p.x = e.clientX; p.y = e.clientY; ultimoPonto = { x: e.clientX, y: e.clientY };
  }
  frente.style.cursor = segurando ? "grabbing" : itemSob(e.clientX, e.clientY) ? "grab" : "default";
});
frente.addEventListener("pointerup", () => { if (segurando) { itens[segurando].solto.arrastando = false; segurando = null; } });

function anunciarMorte(){
