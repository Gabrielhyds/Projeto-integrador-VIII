  }
  const derretendo = clamp(morte.aquecendo / 5);   // 0..1 antes de derreter de vez
  const pm = morte.inicio ? clamp((agora - morte.inicio) / (morte.tipo === "calor" ? 3000 : 1500)) : 0;   // progresso da queda
  const morto = !!morte.inicio;
  const congelando = clamp(morte.exposto / 3);

  const treme = !morto && sente > .3 ? Math.sin(agora / 25) * (3 + congelando * 6) * sente : 0;
  const respira = morto ? 0 : Math.sin(agora / 600) * 2;
  const murcha = morto ? 0 : calor * 10;
  boneco = { x: x0 + treme, y: chao, s };

  fx.save(); fx.translate(x0 + treme, chao); fx.scale(s, s);
  fx.fillStyle = `rgba(0,0,0,${.18 + calor * .15})`;
  fx.beginPath(); fx.ellipse(morto ? -60 * pm : 0, 0, 50 + calor * 15 + pm * 50, 9, 0, 0, 7); fx.fill();

  const ease = 1 - Math.pow(1 - pm, 3);
  const derreteu = morto && morte.tipo === "calor";
  // poça de "boneco derretido" se espalhando no chão
  const poca = derreteu ? ease : derretendo * .3;
  if (poca > 0) {
